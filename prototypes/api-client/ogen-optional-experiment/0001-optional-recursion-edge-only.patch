diff --git a/gen/ir/recursion.go b/gen/ir/recursion.go
--- a/gen/ir/recursion.go
+++ b/gen/ir/recursion.go
@@ -43,6 +43,13 @@ func (t *Type) recursive(target *Type, path *walkpath) bool {
 	case KindGeneric:
 		return t.recursive(target.GenericOf, path)
 	case KindStruct:
 		return slices.ContainsFunc(target.Fields, func(f *Field) (r bool) {
+			// Optional fields are represented through pointers. They break
+			// value-recursion and must not make an enclosing required field
+			// look recursive. The field currently being checked is still
+			// detected by the equality check above and will be pointer-boxed.
+			if f.Spec != nil && !f.Spec.Required {
+				return false
+			}
 			return t.recursive(f.Type, path)
 		})
